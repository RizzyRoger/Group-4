{
  "manifest_version": 3,
  "name": "Group Four",
  "version": "1.1.0",
  "description": "One-click tab grouping from tab titles, locally.",
  "minimum_chrome_version": "89",
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Group Four: only ungrouped tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Group tabs in the current window"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
