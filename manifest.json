{
  "manifest_version": 3,
  "name": "Group Four",
  "version": "1.0.0",
  "description": "One-click AI tab grouping using Grok.",
  "minimum_chrome_version": "89",
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
  "host_permissions": ["https://api.x.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Group Four: only ungrouped tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
